# ── 필수 ──────────────────────────────────────────────────────────────────
# 전용 DB 컨테이너(compose 서비스 db) 설정 — db 컨테이너가 이 파일을 env_file로 읽는다.
# 비밀번호: openssl rand -hex 24
POSTGRES_USER="home_library_app"
POSTGRES_DB="home_library_db"
POSTGRES_PASSWORD="<DB_PASSWORD>"

# 컨테이너 DNS 기준(호스트 = compose 서비스명 db). 완성된 문자열이어야 한다 —
# env_file은 ${POSTGRES_PASSWORD}를 치환해 주지 않으므로 같은 비밀번호를 직접 적는다.
DATABASE_URL="postgresql://home_library_app:<DB_PASSWORD>@db:5432/home_library_db"

# 세션 JWT 서명 키: openssl rand -base64 32
AUTH_SECRET=""

# 가족 공용 로그인 PIN(구성원을 고른 뒤 입력). 숫자 4~8자리 권장.
FAMILY_PIN=""

# 최초 배포 때 만들 첫 관리자 이름(구성원이 한 명도 없을 때만 쓰임).
SEED_ADMIN_NAME="아빠"

# ── 선택(없으면 해당 기능만 꺼짐) ──────────────────────────────────────────
# 카카오 책 검색: ISBN·제목으로 서지/표지 자동 채우기, '좋아한 저자의 다른 책' 추천
# https://developers.kakao.com → 내 애플리케이션 → REST API 키
KAKAO_REST_API_KEY=""

# 국립중앙도서관 ISBN 서지정보(KDC 분류 보강) — https://www.nl.go.kr/seoji/ 에서 인증키 신청
NL_SEOJI_API_KEY=""

# 도서관 정보나루(마니아·다독자 추천도서) — https://www.data4library.kr 에서 인증키 신청
DATA4LIBRARY_API_KEY=""

# Claude API: 서가 사진 책등 판독, 추천 선정·이유 — https://platform.claude.com
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"   # 기본값. 비용을 줄이려면 다른 모델로 바꿀 수 있다.

# 쿠키 Secure 속성 — HTTPS 리버스 프록시 뒤에 있을 때만 "1"
COOKIE_SECURE=""

# /api/health 응답에 표시(배포 도구가 주입, 없으면 "dev")
APP_VERSION=""
