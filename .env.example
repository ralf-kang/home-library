# ── 필수 ──────────────────────────────────────────────────────────────────
# 컨테이너 DNS 기준(shared-db-net 공용 네트워크의 shared-postgres). 완성된 문자열이어야 한다 —
# docker-compose는 ${DB_PASSWORD}를 치환해 주지 않는다. 비밀번호는 NAS secrets에서 주입.
DATABASE_URL="postgresql://home_library_app:<DB_PASSWORD>@shared-postgres:5432/home_library_db"

# 세션 JWT·OAuth 상태 쿠키 서명 키: openssl rand -base64 32
AUTH_SECRET=""

# 서비스 공개 주소(끝에 / 없이). 구글 OAuth 리디렉션 URI = ${APP_URL}/api/auth/google/callback
# 구글 규칙: HTTPS 이거나 http://localhost 만 허용, IP 주소 불가 → 운영은 도메인+HTTPS 필요
APP_URL="https://library.example.com"

# 구글 로그인(OpenID Connect) — https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
#  · OAuth 동의 화면: 앱 이름 '우리집 서재', 지원 이메일, 홈페이지 ${APP_URL}, 개인정보 ${APP_URL}/privacy, 약관 ${APP_URL}/terms
#  · OAuth 클라이언트 ID(웹 애플리케이션) → 승인된 리디렉션 URI 에 ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 플랫폼 관리자(/admin: 가입·활성 지표, 후원 배너) — 쉼표로 구분한 구글 계정 이메일
PLATFORM_ADMIN_EMAILS="ralfkang@outlook.com"

# 쿠키 Secure 속성 — HTTPS 로 서비스할 때 "1"(운영 필수)
COOKIE_SECURE=""

# 테스트 로그인(구글 없이 이메일로 로그인) — 개발·랩 전용. 운영에서는 절대 켜지 말 것
ENABLE_DEV_LOGIN=""

# ── 선택(없으면 해당 기능만 꺼짐) ──────────────────────────────────────────
# 카카오 책 검색: ISBN·제목으로 서지/표지 자동 채우기, '좋아한 저자의 다른 책' 추천
KAKAO_REST_API_KEY=""

# 국립중앙도서관 ISBN 서지정보(KDC 분류 보강) — https://www.nl.go.kr/seoji/
NL_SEOJI_API_KEY=""
# 국립중앙도서관 Open API(사서추천도서) — 없으면 NL_SEOJI_API_KEY 로 시도
NL_OPEN_API_KEY=""

# 도서관 정보나루 — 추천, 지역 인기대출, 근처 도서관 소장·대출 가능 여부 — https://www.data4library.kr
DATA4LIBRARY_API_KEY=""

# 공공데이터포털 일반 인증키(Decoding) — 전국도서관표준데이터(15013109), 법정동코드(15077871)
DATA_GO_KR_SERVICE_KEY=""

# Google Books API — '책 내용으로 찾기'(Google Cloud Console 에서 Books API 사용 설정 후 API 키)
GOOGLE_BOOKS_API_KEY=""

# Claude API: 서가 사진 책등 판독, 추천 선정·이유, 내용 검색 보조 — https://platform.claude.com
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"   # 기본값. 비용을 줄이려면 다른 모델로 바꿀 수 있다.

# 알라딘 TTB 키 — 구매 링크 제휴(수익화). 링크 옆에 '제휴' 표시가 붙는다
ALADIN_TTB_KEY=""

# 요금제 한도 검사 — 지금은 꺼 둔다(모든 기능 무료). docs/monetization.md
MONETIZATION_ENABLED=""

# /api/health 응답에 표시(배포 도구가 주입, 없으면 "dev")
APP_VERSION=""
